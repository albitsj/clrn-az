{
  "name": "clrn-az",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "npm run lint:js && npm run lint:python && npm run lint:shell && npm run lint:workflows && npm run lint:lines && npm run lint:architecture && npm run lint:duplicates",
    "test": "node scripts/test-local.mjs",
    "test:android:collect": "playwright test --config android/playwright.config.ts --list > /dev/null",
    "check": "npm run lint && npm run typecheck && npm run test:android:collect && npm test",
    "lint:js": "node scripts/lint-ratchet.mjs eslint",
    "lint:python": "node scripts/lint-ratchet.mjs ruff",
    "lint:shell": "node scripts/lint-shell.mjs",
    "lint:workflows": "uvx --from actionlint-py==1.7.12.25 --with shellcheck-py==0.11.0.1 actionlint -pyflakes= -ignore 'unexpected key \"queue\" for \"concurrency\" section'",
    "lint:lines": "node lint-lines.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:architecture": "node scripts/lint-ratchet.mjs dependency-cruiser",
    "lint:duplicates": "node scripts/lint-duplicates.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "22.15.30",
    "@types/pngjs": "6.0.5",
    "dependency-cruiser": "17.3.9",
    "eslint": "10.12.0",
    "eslint-plugin-jsdoc": "63.0.0",
    "eslint-plugin-tsdoc": "0.5.4",
    "globals": "17.13.0",
    "jscpd": "5.1.2",
    "pngjs": "7.0.0",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/linux-x64": "4.1.0"
  }
}
